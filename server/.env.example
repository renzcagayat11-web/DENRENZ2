# ─── Cloudinary (Image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email / SMTP (Nodemailer) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── SMS / Twilio ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ─── OCR — Azure Document Intelligence ───────────────────────────────────────
# Get these from Azure Portal → Document Intelligence resource → Keys and Endpoint
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-azure-key-here

# ─── OCR — OCR.space (public page permit scan) ───────────────────────────────
# Free tier key from https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=K88896788488957

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
